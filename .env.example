# ==============================================================================
# Goddard Rocket Design Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the repository root and populate with your credentials:
#   cp .env.example .env
#
# When running in offline or mock mode (e.g. CI or local CAD decoupling),
# set GODDARD_OFFLINE_MODE=true.
# ==============================================================================

# Onshape API Credentials (https://cad.onshape.com/appstore/dev-portal)
ONSHAPE_ACCESS_KEY=your_access_key_here
ONSHAPE_SECRET_KEY=your_secret_key_here

# Target Onshape Document / Workspace / Element IDs
# Derived from document URL: https://cad.onshape.com/documents/<DID>/w/<WID>/e/<EID>
ONSHAPE_DID=your_document_id_here
ONSHAPE_WID=your_workspace_id_here
ONSHAPE_EID=your_element_id_here

# Goddard Server & Telemetry UI Configuration
GODDARD_PORT=8050
GODDARD_ENV=development

# Simulation & Execution Mode
# If true, Goddard operates using local geometric synthesizers and cached physics models
# without making live external API network requests to Onshape.
GODDARD_OFFLINE_MODE=false
